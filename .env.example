# Environment variables (copy to .env for local overrides; never commit .env)

# Root of the ARK installation. Defaults to the repository directory itself.
ARK_HOME=/opt

# Set to 1 for verbose debugging: DEBUG log level, SQL echo, verbose sidecar output.
# ARK_DEBUG=1

# Force a log level (TRACE/DEBUG/INFO/WARNING/ERROR). Overrides ark.toml at startup.
# A runtime change from the UI (Settings / Logs page) is persisted in the DB and
# takes effect on restart only when this variable is unset.
# LOG_LEVEL=INFO

# Bootstrap only: if no admin account exists yet, create it with this password
# instead of a generated one. Leave unset to have a random password generated
# into data/config/initial-credentials.txt (chmod 600).
# ARK_ADMIN_PASSWORD=change-me
